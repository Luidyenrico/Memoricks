GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Contas Google (ativar após configurar a origem correta e o e-mail proprietário).
MULTIUSER_ENABLED=0
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
MEMORICKS_OWNER_EMAIL=seu_email@gmail.com
# Em produção com HTTPS, use 1.
AUTH_COOKIE_SECURE=0

# Opcional: origens do frontend autorizadas, separadas por vírgula.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opcional: caminho absoluto para outra base SQLite.
# DATABASE_URL=sqlite:///C:/caminho/memoricks.db
